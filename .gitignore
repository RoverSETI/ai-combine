# ============================================================
# Репозиторий «ai-combine» (корень = /home/rover)
# Стратегия: всё игнорируется по умолчанию (/*), в Git ведётся
# ТОЛЬКО белый список файлов проекта. Секреты и тяжёлые данные
# исключены явно + двойной защитой внизу.
# ============================================================

/*
# --- CI (GitHub Actions) ---
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/*.yml

# --- корень репозитория ---
!/.gitignore
!/README.md
# --- каталоги проекта ---
!/AiStart/
!/OpenWebUI-Local/
!/llama-cuda13/

# --- личное: НЕ публиковать никогда ---
/GoogleDrive/

# --- AiStart: код, конфиги, документы (явно, поимённо) ---
/AiStart/*
!/AiStart/mcp_server.py
!/AiStart/habr_scan.py
!/AiStart/habr_bookmarks.py
!/AiStart/habr_fetch.py
!/AiStart/habr_config.json
!/AiStart/ask_kb.py
!/AiStart/photo_fix.py
!/AiStart/agent_cli.sh
!/AiStart/start_ai.sh
!/AiStart/stop_ai.sh
!/AiStart/status_ai.sh
!/AiStart/models.ini
!/AiStart/agents.json
!/AiStart/obsidian.json
!/AiStart/README.md
!/AiStart/ОТКАТ.txt
!/AiStart/GIT-УЧЕБНИК.md
!/AiStart/Снимок экрана_2026-10-24_14-09-34.png

# --- OpenWebUI-Local: скрипты Знаний/E2E и инструкции ---
/OpenWebUI-Local/*
!/OpenWebUI-Local/scripts/
/OpenWebUI-Local/scripts/*
!/OpenWebUI-Local/scripts/*.py
!/OpenWebUI-Local/ИНСТРУКЦИЯ-ИИ.md
!/OpenWebUI-Local/ИНСТРУКЦИЯ-ГРАФИКА.html

# --- llama-cuda13: только документ отката (бинарники не ведём) ---
/llama-cuda13/*
!/llama-cuda13/ОТКАТ.txt

# ============================================================
# AI-Combine: единая папка комбайна (07.11.2026, компоненты перемещены)
# ============================================================
!/AI-Combine/
/AI-Combine/*
!/AI-Combine/СТРУКТУРА.md
!/AI-Combine/docs/
/AI-Combine/docs/*
!/AI-Combine/docs/**

# AiStart: весь код/конфиги (секреты и мусор запрещены внизу)
!/AI-Combine/AiStart/
/AI-Combine/AiStart/*
!/AI-Combine/AiStart/**
/AI-Combine/AiStart/logs/
/AI-Combine/AiStart/run/
/AI-Combine/AiStart/mod/
/AI-Combine/AiStart/Снимок экрана_2026-10-24_14-09-34.png

# SwarmConfig: конфиги роя, генератор, инструкции, функция компрессора
!/AI-Combine/SwarmConfig/
/AI-Combine/SwarmConfig/*
!/AI-Combine/SwarmConfig/**
/AI-Combine/SwarmConfig/backup/
/AI-Combine/SwarmConfig/state/

# OpenWebUI-Local: скрипты Знаний/E2E и инструкции (venv/data — вне Git)
!/AI-Combine/OpenWebUI-Local/
/AI-Combine/OpenWebUI-Local/*
!/AI-Combine/OpenWebUI-Local/scripts/
/AI-Combine/OpenWebUI-Local/scripts/*
!/AI-Combine/OpenWebUI-Local/scripts/*.py
!/AI-Combine/OpenWebUI-Local/ИНСТРУКЦИЯ-ИИ.md
!/AI-Combine/OpenWebUI-Local/ИНСТРУКЦИЯ-ГРАФИКА.html

# giga_speech: только python-скрипты STT (venv и веса model/ — вне Git)
!/AI-Combine/giga_speech/
/AI-Combine/giga_speech/*
!/AI-Combine/giga_speech/*.py

# mcp-gimp: мост целиком (6 МБ, конфиги/скрипты)
!/AI-Combine/mcp-gimp/
/AI-Combine/mcp-gimp/*
!/AI-Combine/mcp-gimp/**

# mcp-inkscape: код (venv запрещён глобальным правилом .venv*/ внизу)
!/AI-Combine/mcp-inkscape/
/AI-Combine/mcp-inkscape/*
!/AI-Combine/mcp-inkscape/**

# llama-cuda13 (новый путь): только документ отката
!/AI-Combine/llama-cuda13/
/AI-Combine/llama-cuda13/*
!/AI-Combine/llama-cuda13/ОТКАТ.txt

# ============================================================
# ЗАЩИТА СЕКРЕТОВ И МУСОРА (запрещено всегда, даже в белом списке)
# ============================================================
PolzaKey*
ZaiKey*
.webui_token
.webui_secret_key
*.log
*.bak*
webui.db*
*~
*.pyc
__pycache__/
.venv*/
habr_index.json
habr_state.json
habr_fetch_jobs.json
*.key
*.pem

# SwarmConfig: локальные бэкапы и runtime-состояние
SwarmConfig/backup/
SwarmConfig/state/
